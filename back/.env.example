# PostgreSQL with real company data (read-only queries only)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/company

# Qdrant vector database (local)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_docs

# Ollama (local model runtime)
OLLAMA_BASE_URL=http://localhost:11434
# Must support tool calling: qwen3 / qwen2.5 work, Gemma does NOT (no tool support in Ollama)
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# LLM sampling parameters (defaults applied in code if unset)
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TOP_K=30
# Context window; must fit system prompt (persona + DB schema) + memory
LLM_NUM_CTX=8192

# Document chunking for Qdrant ingest (defaults applied in code if unset)
CHUNK_SIZE=400
CHUNK_OVERLAP=60
