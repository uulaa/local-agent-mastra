# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=agent
POSTGRES_PASSWORD=agentpass
POSTGRES_DB=company
POSTGRES_PORT=5432

# ── Qdrant ─────────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_COLLECTION=company_docs

# ── LLM (Ollama in Docker) ─────────────────────────────────
OLLAMA_PORT=11434
# Must support tool calling: qwen3 / qwen2.5 work, Gemma does NOT.
# Smaller/faster alternative for weak machines: qwen3:1.7b
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── LLM sampling parameters ────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TOP_K=30
# Context window in tokens. Must fit system prompt + conversation memory;
# Ollama's 4096 default silently truncates the instructions. More = more RAM.
LLM_NUM_CTX=8192

# ── Document chunking (Qdrant ingest) ──────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=60

# ── Service ports on the host ──────────────────────────────
BACK_PORT=4111
WEB_PORT=3000
